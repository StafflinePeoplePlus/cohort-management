{
	"name": "@peopleplus/cohort-management",
	"version": "0.6.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"codegen": "graphql-codegen --config codegen.ts && node scripts/patchGeneratedTypes.js && node scripts/createSchemaExport.js",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"release": "npm run build && changeset publish"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"svelte": "./dist/client.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		}
	},
	"typesVersions": {
		"*": {
			"index.d.ts": [
				"dist/index.d.ts"
			],
			"client": [
				"dist/client.d.ts"
			],
			"server": [
				"dist/server.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"schema.graphql",
		"defaults.graphql"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/StafflinePeoplePlus/cohort-management.git"
	},
	"author": "James Birtles <james.birtles@peopleplus.co.uk>",
	"bugs": {
		"url": "https://github.com/StafflinePeoplePlus/cohort-management/issues"
	},
	"homepage": "https://github.com/StafflinePeoplePlus/cohort-management#readme",
	"peerDependencies": {
		"@sveltejs/kit": "^1.0.0 || ^2.0.0",
		"svelte": ">=4.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.1",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.25.1",
		"@faker-js/faker": "^9.0.2",
		"@graphql-codegen/add": "^5.0.0",
		"@graphql-codegen/cli": "5.0.5",
		"@graphql-codegen/typescript": "4.1.6",
		"@graphql-codegen/typescript-resolvers": "5.0.0",
		"@graphql-tools/executor-http": "^2.0.0",
		"@storybook/addon-docs": "^9.0.0-beta.1",
		"@storybook/addon-links": "^9.0.0-beta.1",
		"@storybook/sveltekit": "^9.0.0-beta.1",
		"@storybook/testing-library": "^0.2.2",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.5.27",
		"@sveltejs/package": "^2.3.7",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@typescript-eslint/eslint-plugin": "^8.31.0",
		"@typescript-eslint/parser": "^8.31.0",
		"autoprefixer": "^10.4.16",
		"eslint": "^9.25.1",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-storybook": "^9.0.0-beta.1",
		"eslint-plugin-svelte": "^3.5.1",
		"globals": "^16.0.0",
		"graphql-yoga": "^5.0.2",
		"postcss": "^8.4.32",
		"prettier": "~3.5.3",
		"prettier-plugin-svelte": "~3.3.3",
		"publint": "^0.3.0",
		"storybook": "^9.0.0-beta.1",
		"svelte": "^5.28.2",
		"svelte-check": "^4.0.2",
		"tailwindcss": "^4.1.4",
		"tslib": "^2.6.2",
		"typescript": "^5.5.0",
		"vite": "^6.3.3",
		"vitest": "^3.1.2"
	},
	"dependencies": {
		"@peopleplus/components": "^0.0.0-snapshot-20250424104414",
		"graphql": "^16.8.1",
		"lucide-svelte": "^0.503.0",
		"tailwind-merge": "^3.2.0",
		"type-fest": "^4.8.3"
	},
	"overrides": {
		"@storybook/svelte-vite": {
			"vite": "$vite"
		},
		"@storybook/sveltekit": {
			"vite": "$vite"
		},
		"storybook": "$storybook"
	}
}
